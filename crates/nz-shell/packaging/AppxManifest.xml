<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse package that gives NextZip package identity so its IExplorerCommand
  appears in the Windows 11 top-level context menu. The files stay in the
  install folder (ExternalLocation); the package contains only this manifest
  and the logo. See register-sparse.ps1.

  Publisher must match the certificate used to sign the package.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">
  <Identity Name="NextZip.ShellExtension" Publisher="CN=NextZip Dev" Version="0.1.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>NextZip</DisplayName>
    <PublisherDisplayName>NextZip</PublisherDisplayName>
    <Logo>logo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources>
    <Resource Language="ko-kr" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
  <Applications>
    <Application Id="NextZip" Executable="nextzip.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements DisplayName="NextZip" Description="NextZip" BackgroundColor="transparent"
        Square150x150Logo="logo.png" Square44x44Logo="logo.png" AppListEntry="none" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="NextZip" Clsid="5870dc66-afb5-4e9c-ab2a-31f1bd5321d9" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="NextZip" Clsid="5870dc66-afb5-4e9c-ab2a-31f1bd5321d9" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="NextZip context menu">
              <com:Class Id="5870dc66-afb5-4e9c-ab2a-31f1bd5321d9" Path="nextzip_shell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
